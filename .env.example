# Names only — never commit real values (repo is public).
# Secrets live in GitHub Actions secrets (worker), Supabase secrets (Edge Function) and local .env.
LLM_PROVIDER=groq
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_MAX_RETRIES=4
SUPABASE_URL=
# Elevated key for the audit worker: sb_secret_... (new-style) or the legacy
# service_role key during transition. Never a publishable/anon key.
SUPABASE_SECRET_KEY=
# Public key for the dashboard build: sb_publishable_... (new-style) or the
# legacy anon key. Safe to expose in the browser (RLS read-only).
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_EVIDENCE_BUCKET=evidence
GITHUB_PAT=
GITHUB_REPO=
DEMO_SITE_URL=
AUDIT_ALLOWLIST=
MAX_PAGES_PER_RUN=5
CRAWL_DELAY_MS=2000
MAX_RUNS_PER_HOUR=10
APPROVAL_MODE=required
